NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role (server/scripts only) — needed for scripts/refresh-story-listen-scripts.ts
SUPABASE_SERVICE_ROLE_KEY=

# Temporary maintenance mode (server-only)
# When true, / shows a busy page and all routes are locked until unlocked.
# Tap the logo 5x on the busy page and enter MAINTENANCE_UNLOCK_SECRET.
MAINTENANCE_MODE=false
MAINTENANCE_UNLOCK_SECRET=brokenheart
# Bump this (e.g. 2 → 3) and redeploy to revoke every chamber-key unlock.
MAINTENANCE_BYPASS_VERSION=2

# Cloudflare R2 (server-only — set in Coolify)
# Uploads go through /api/storage/upload (no browser→R2 CORS required).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=queen-sisi-media

# Anthropic Claude (server-only) — slave story rewrite
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-6)
# ANTHROPIC_STORY_MODEL=claude-sonnet-4-6

# xAI Grok (server-only) — story rewrite + blog covers
# Create a key at https://console.x.ai/ → API Keys
XAI_API_KEY=
# Optional overrides
# XAI_STORY_MODEL=grok-4.5
# XAI_IMAGINE_MODEL=grok-imagine-image-2.0

# Fish Audio (server-only) — Story Listen (author narrates; quotes = other)
# API key: https://fish.audio/app/api-keys
# Clone both voices in Fish, then set the model/voice IDs here.
# Use the single best clone per person — extra/alternate models drift more.
FISH_API_KEY=
FISH_QUEEN_VOICE_ID=
FISH_SLAVE_VOICE_ID=
# Optional (default s2.1-pro). Use s2.1-pro-free for the free developer tier.
# FISH_TTS_MODEL=s2.1-pro
# Voice stability (defaults keep timbre consistent; lower temp = less drift)
# FISH_TTS_TEMPERATURE=0.3
# FISH_TTS_TOP_P=0.75
